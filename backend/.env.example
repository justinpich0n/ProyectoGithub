# Plantilla: sustituye el usuario y la contraseña solo en tu .env local.
PORT=3000
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bizzstock
DB_USER=usuario_local
DB_PASSWORD="reemplazar_localmente"

# Origen exacto del frontend para CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173
# SHA-256 de una clave privada aleatoria para el asistente inicial (nunca usar un valor público)
BIZZSTOCK_SETUP_TOKEN_HASH=

# Clave privada y estable de al menos 32 caracteres para la huella del documento.
BIZZSTOCK_DOCUMENTO_KEY=
