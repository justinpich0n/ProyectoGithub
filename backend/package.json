{
  "name": "bizzstock-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de BizzStock para la papelería y variedades Arte y Belleza",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "test": "node --test test/health.test.js",
    "test:integration": "node test/crud.integration.js",
    "crear:cuenta": "node scripts/crear-cuenta.js",
    "test:ppi": "node test/ppi.integration.js",
    "test:rendimiento": "node scripts/probar-rendimiento.js",
    "test:acceso": "node test/inicio.integration.js",
    "test:registro-ventas": "node test/registro-ventas.integration.js",
    "test:compradores-caja": "node test/compradores-caja.integration.js",
    "test:perfil-documentos": "node test/perfil-documentos.integration.js",
    "test:cobro": "node test/cobro.integration.js",
    "test:regresion": "npm test && npm run test:acceso && npm run test:compradores-caja && npm run test:registro-ventas && npm run test:perfil-documentos && npm run test:cobro && npm run test:ppi"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14"
  }
}
